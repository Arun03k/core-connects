FLASK_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/coreconnect_dev
MONGO_DBNAME=coreconnect_dev
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Production requires independent random values of at least 32 characters.
# Development generates an ephemeral signing key when these are omitted.
# SECRET_KEY=
# JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
